# Copie este archivo como .env y complete los valores.

# Servidor
PORT=3000
# URL pública con la que los clientes abrirán el enlace de seguimiento
PUBLIC_URL=http://localhost:3000
NOMBRE_NEGOCIO=Joyería
# Código ISO de la moneda (USD, MXN, PEN, COP, EUR…)
MONEDA=USD
# Recargo por pago con tarjeta, en %
RECARGO_TARJETA=6
# Código de país para convertir teléfonos locales (0999…) a formato internacional de WhatsApp
CODIGO_PAIS=593

# Acceso al panel interno (déjelo vacío solo para pruebas locales)
APP_PASSWORD=
SESSION_SECRET=

# Correo automático (SMTP). Ejemplo Gmail: smtp.gmail.com, 465, usuario y contraseña de aplicación
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Joyería <ordenes@ejemplo.com>"

# WhatsApp automático (API de WhatsApp Cloud de Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Para mensajes iniciados por el negocio Meta exige una plantilla aprobada con un parámetro {{1}} en el cuerpo
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es
